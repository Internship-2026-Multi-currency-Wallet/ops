{
  "uid": "internship-services",
  "title": "Services",
  "tags": ["internship"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(env)",
        "definition": "label_values(env)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "allValue": ".+",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(service)",
        "definition": "label_values(service)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "allValue": ".+",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Availability",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Public /health (what users see)",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_success{env=~\"$env\", service=~\"$service\"}",
          "legendFormat": "{{env}} {{service}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Metrics scrape (up)",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"backends\", env=~\"$env\", service=~\"$service\"}",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (env, service) (rate(http_requests_total{env=~\"$env\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{env}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error rate (5xx + INTERNAL_SERVER_ERROR)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_max(100 * ((sum by (env, service) (rate(http_requests_total{env=~\"$env\", service=~\"$service\", status=~\"5..\"}[$__rate_interval])) or 0 * sum by (env, service) (rate(http_requests_total{env=~\"$env\", service=~\"$service\"}[$__rate_interval]))) + (sum by (env, service) (rate(graphql_errors_total{env=~\"$env\", service=~\"$service\", code=\"INTERNAL_SERVER_ERROR\"}[$__rate_interval])) or 0 * sum by (env, service) (rate(http_requests_total{env=~\"$env\", service=~\"$service\"}[$__rate_interval])))) / sum by (env, service) (rate(http_requests_total{env=~\"$env\", service=~\"$service\"}[$__rate_interval])), 100)",
          "legendFormat": "{{env}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le, env, service) (rate(http_request_duration_seconds_bucket{env=~\"$env\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50 {{env}} {{service}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, env, service) (rate(http_request_duration_seconds_bucket{env=~\"$env\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95 {{env}} {{service}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, env, service) (rate(http_request_duration_seconds_bucket{env=~\"$env\", service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99 {{env}} {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GraphQL errors by code",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (env, service, code) (rate(graphql_errors_total{env=~\"$env\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{env}} {{service}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top 10 slowest operations (p95 over the selected range)",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, env, service, operation) (rate(http_request_duration_seconds_bucket{env=~\"$env\", service=~\"$service\"}[$__range]))) > 0)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "env": 0,
              "service": 1,
              "operation": 2,
              "Value": 3
            },
            "renameByName": { "Value": "p95" }
          }
        }
      ],
      "options": {
        "sortBy": [{ "displayName": "p95", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Runtime (per process, never summed)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 33, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Event-loop lag (p99)",
      "gridPos": { "x": 0, "y": 34, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_eventloop_lag_p99_seconds{env=~\"$env\", service=~\"$service\"}",
          "legendFormat": "{{env}} {{service}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Heap used",
      "gridPos": { "x": 9, "y": 34, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_heap_size_used_bytes{env=~\"$env\", service=~\"$service\"}",
          "legendFormat": "{{env}} {{service}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Restarts and deploys (selected range)",
      "gridPos": { "x": 18, "y": 34, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(count by (env, service) (count_over_time(process_start_time_seconds{env=~\"$env\", service=~\"$service\"}[$__range])) - 1, 0) + sum by (env, service) (changes(process_start_time_seconds{env=~\"$env\", service=~\"$service\"}[$__range]))",
          "legendFormat": "{{env}} {{service}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
