# Optional: copy to .env next to docker-compose.yml to change the defaults.
# Local-only values. Never put real secrets here.

# Client all services run as: demo | kvitka | wisla
CLIENT=demo

# Environment name of the backends: local | staging | kvitka-uat | wisla-uat.
# Prefixes all Redis channels/streams/queues. DEV_AUTH=true is refused for *-uat.
APP_ENV=local

# Dev auth in the backends ("Authorization: Dev <userId>:<perms>"). Local stack only.
DEV_AUTH=true

# Dev users baked into the frontends (rebuild the frontend after changing)
CLIENT_WEB_DEV_USER=1:wallet
BACK_OFFICE_DEV_USER=100:bo:users,bo:users:modify

# MySQL (local only)
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=wallet
MYSQL_PASSWORD=wallet

# Host ports
MYSQL_PORT=3306
REDIS_PORT=6379
WALLET_CORE_PORT=3000
RATES_SERVICE_PORT=3001
TREASURY_SERVICE_PORT=3002
CLIENT_WEB_PORT=8080
BACK_OFFICE_PORT=8081
